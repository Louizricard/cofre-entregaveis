# Copie para .env; preencha a senha local antes de iniciar.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://cofre:SUA_SENHA_LOCAL@localhost:5432/cofre?schema=public
APP_ORIGIN=http://localhost:8080
PORT=3000
NODE_ENV=development
SESSION_DAYS=7

# Bucket R2 privado de desenvolvimento. Nunca coloque credenciais no Flutter.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_PYTHON=

generator client {
 provider = "prisma-client"
 output = "../generated/client"
 moduleFormat = "esm"
 importFileExtension = "js"
}
datasource db {
 provider = "postgresql"
}
enum MemberRole {
 OWNER
 MEMBER
}
model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique @db.VarChar(254)
 name String @db.VarChar(120)
 passwordHash String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 memberships WorkspaceMember[]
 sessions Session[]
}
model Workspace {
 id String @id @default(uuid()) @db.Uuid
 name String @db.VarChar(120)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 clients Client[]
 projects Project[]
 members WorkspaceMember[]
 sessions Session[]
}
model WorkspaceMember {
 workspaceId String @db.Uuid
 userId String @db.Uuid
 role MemberRole @default(MEMBER)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@id([workspaceId, userId])
 @@index([userId])
}
model Session {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique @db.Char(64)
 userId String @db.Uuid
 workspaceId String @db.Uuid
 expiresAt DateTime @db.Timestamptz(3)
 revokedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
 @@index([userId, expiresAt])
 @@index([workspaceId])
}

enum ProjectStatus {
 ACTIVE
 ARCHIVED
}
model Client {
 id String @id @default(uuid()) @db.Uuid
 workspaceId String @db.Uuid
 name String @db.VarChar(120)
 email String @db.VarChar(254)
 revision Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
 projects Project[]
 @@unique([workspaceId, email])
 @@unique([id, workspaceId])
 @@index([workspaceId, id])
}
model Project {
 id String @id @default(uuid()) @db.Uuid
 workspaceId String @db.Uuid
 clientId String @db.Uuid
 title String @db.VarChar(120)
 currency String @default("BRL") @db.Char(3)
 balanceCents Int
 includedRevisionRounds Int
 status ProjectStatus @default(ACTIVE)
 revision Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
 client Client @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
 @@index([workspaceId, status, id])
 @@index([clientId, workspaceId])
}
